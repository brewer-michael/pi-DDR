# pi-DDR recommended OutFox preferences, merged into the [Options] section of
# ~/.project-outfox/Save/Preferences.ini by apply-prefs.sh.
# Why each one: docs/latency-and-sync.md, "Game settings".
# Input mapping, GlobalOffsetSeconds and VisualDelaySeconds are set inside
# OutFox (calibration), not here.

# Talk to ALSA directly instead of going through PulseAudio/PipeWire.
SoundDrivers=ALSA-sw
# HDMI0 (the micro-HDMI port next to USB-C power) via ALSA's "hdmi" device,
# which only packs samples into HDMI's frame format: no resampling, no effects.
SoundDevice=hdmi:CARD=vc4hdmi0,DEV=0
# One sample rate end to end: game, HDMI link and receiver all at 48 kHz.
SoundPreferredSampleRate=48000
Vsync=1
# Read pads as plain SDL joysticks (OutFox's "HIDAPI"/legacy mode, also its
# default): every button of the virtual stage keeps its own number. XInput mode
# would need a gamepad layout, which a 22-button stage doesn't have.
UseOldJoystickMapping=1
# Keep the key map when the set of joysticks changes. OutFox's own Keymaps
# guide says to turn automapping off so a custom mapping isn't overwritten.
AutoMapOnJoyChange=0
