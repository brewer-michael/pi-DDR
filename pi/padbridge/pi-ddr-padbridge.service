[Unit]
Description=pi-DDR pad bridge (two mats -> one virtual joystick, pi-DDR Stage)
After=systemd-udevd.service
# The virtual stage must exist before the game starts from the tty1 autologin,
# so OutFox finds it when it opens its joysticks. Type=notify makes that
# ordering real: the bridge reports ready only after it has created it.
Before=getty@tty1.service display-manager.service

[Service]
Type=notify
Environment=PYTHONPATH=/opt/pi-ddr PYTHONUNBUFFERED=1
ExecStartPre=-/usr/sbin/modprobe uinput
ExecStart=/usr/bin/python3 -m piddr.padbridge --config /etc/pi-ddr/padbridge.conf
# Don't hold up the console login for long if something is badly wrong.
TimeoutStartSec=20
# Forward steps ahead of rendering and everything else. The loop sleeps in
# select() between reports, so real-time priority costs almost nothing.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
