# pi-DDR pad bridge config (example).
# Generate the real one on the Pi instead of editing this by hand:
#   sudo python3 -m piddr.matprobe learn --out /etc/pi-ddr/padbridge.conf
# Syntax: control = input[, input...]. An input is a button name
# (BTN_TRIGGER, key:300) or an axis direction (ABS_HAT0X-, ABS_Y+).
# Controls: left down up right upleft upright downleft downright start back select

[bridge]
# USB vendor:product of the raw mats. The udev rule built from this hides the
# raw mats from the game so it only sees the virtual stage, 'pi-DDR Stage'.
mat_ids = 0079:0011
# Hold back releases this long to swallow contact chatter (0 = off).
# Presses are never delayed. Try 10-20 if `matprobe watch` reports chatter.
release_debounce_ms = 0
# Log forwarding-delay stats this often (seconds; 0 = only on SIGUSR1).
stats_interval_s = 300

# P1 is whichever mat is plugged into this USB port. Label the port.
[player1]
device = /dev/input/by-path/platform-fd500000.pcie-pci-0000:01:00.0-usb-0:1.3:1.0-event-joystick
left = BTN_TRIGGER
down = BTN_THUMB
up = BTN_THUMB2
right = BTN_TOP
start = BTN_BASE4
back = BTN_BASE3

[player2]
device = /dev/input/by-path/platform-fd500000.pcie-pci-0000:01:00.0-usb-0:1.4:1.0-event-joystick
left = BTN_TRIGGER
down = BTN_THUMB
up = BTN_THUMB2
right = BTN_TOP
start = BTN_BASE4
back = BTN_BASE3
